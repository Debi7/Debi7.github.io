---
// The post page: maps one entry of the `posts` collection onto ArticleLayout.astro, the frame
// shared with the video page (VideoLayout.astro), and passes the body through. Since
// 2026-09-22 (VIDEO-PAGE.md, section 4). From 2026-09-18 to that day this file held the frame's
// Base layout and the table-of-contents sidebar, and for a day its prop was `Post | Video` so
// that the colleague's video route could render through it; the frame is in ArticleLayout.astro
// now, with the sidebar's notes, so that both pages get it without a copy.
//
// What a post supplies that the frame cannot know: the reading time as the text of the clock
// item (Hugo: math.Round (div (countwords .Content) 200.0), readingTime() in lib/posts.ts, and
// the i18n string reading_time), `lastmod` as the updated date, and the share fields of the
// posts schema, in the order ArticleLayout.astro tries them, and the previous and next posts
// as plain links (postLink()), so that the frame and PostNav.astro know no collection.
import ArticleLayout from "./ArticleLayout.astro";
import type { MarkdownHeading } from "astro";
import { postLink, readingTime, type Post } from "../lib/posts";
import { t } from "../i18n/strings";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  prev: Post | null;
  next: Post | null;
}

const { post, headings, prev, next } = Astro.props;
const { data } = post;
---

<ArticleLayout
  title={data.title}
  description={data.description}
  date={data.date}
  updated={data.lastmod}
  categories={data.categories}
  tags={data.tags}
  timeLabel={`${readingTime(post.body)} ${t.reading_time}`}
  shareTitle={data.share_title ?? data.title}
  shareTexts={[data.share_description, data.description, data.summary]}
  headings={headings}
  prev={prev && postLink(prev)}
  next={next && postLink(next)}
>
  <slot />
</ArticleLayout>
