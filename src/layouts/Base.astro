---
import "../styles/main.css";
import "../styles/custom.css";

import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

import type { SiteConfig, PageLike } from "../lib/seo";
import { site } from "../config";

interface Props {
  title?: string;
  description?: string;
  content?: string;
  isArticle?: boolean;
  isVideo?: boolean;
  publishDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  params?: PageLike["params"];
  // Added the evening of 2026-09-25, the owner's decision: the site is for signed-in members. A page
  // that does not set this is closed to a guest - the gate in the head below sends them to the
  // sign-in page before anything is painted. The home page, the four /auth/ pages and the 404 page
  // set it; on an open page a guest still sees only what is not marked members-only. Named so that
  // false is the default and the safe side (CLAUDE.md, the props rule). Presentation only: the gate
  // reads the same flag as the header icon, and what a visitor may read is decided by the service
  // that holds the data, never here (AUTH.md section 10).
  // (Reworded 2026-09-26 for the move to Clerk: the sentence named the previous auth provider, which
  // CLERK.md section 0 orders out of this branch.)
  // Reopened on 2026-09-25 after the colleague's review (AUTH.md section 11): the site is open to everyone, nothing is sent to the sign-in page any more, and
  // the prop is gone with the redirect it controlled.
}

const {
  title,
  description,
  content,
  isArticle,
  isVideo,
  publishDate,
  updatedDate,
  tags,
  params,
} = Astro.props;

// Named seoSite, not site: under that name it shadowed the import from src/config.ts above,
// which astro check reported as a declaration conflict (renamed 2026-09-16).
// Changed in my-saved-work, merged 2026-09-17: the object is built from src/config.ts and has
// no values of its own, so the tags follow the config. It used to say "Klub biolocation" and
// point at /images/default-share.png, which does not exist. The shape differs because the
// helpers in src/lib/seo.ts expect SiteConfig; baseUrl comes from astro.config.mjs through
// Astro.site. Without share.defaultImage the share image falls back to the avatar.
// See ARTICLE-PAGE-FIX.md, section 9.
const seoSite: SiteConfig = {
  title: site.title,
  baseUrl: Astro.site?.toString() ?? "",
  language: site.language,
  avatar: { url: site.avatar },
};

const page: PageLike = {
  title,
  description,
  content,
  permalink: new URL(Astro.url.pathname, Astro.site).toString(),
  isHome: Astro.url.pathname === "/",
  isPage: Boolean(isArticle),
  // Added 2026-09-22: `isVideo` was accepted as a prop and then dropped here, so it was the one
  // value this layout took and never used - `astro check` said so, and Open Graph called a video
  // page a website. It travels to SEO.astro now, which turns it into `og:type` `video.other`.
  isVideo: Boolean(isVideo),
  publishDate,
  updatedDate,
  tags,
  params: params ?? {},
};
---

<!doctype html>
<html lang={site.language} dir="ltr" class="h-full">
  <head>
    <meta charset="utf-8" />
    {
      /* The guest gate, added the evening of 2026-09-25 (AUTH.md section 10). It is the first thing
      in the head and it is inline on purpose: it has to decide before the browser paints anything,
      and a bundled module runs after the document is parsed, when a guest would already have seen
      the page for a moment. define:vars implies is:inline (Astro 4, "Template directives
      reference"), and it is how the three values reach a block that cannot import.

      What it does: reads the flag the auth pages keep (src/scripts/auth-flag.ts - the five lines
      of readAuthFlag() are repeated here because an inline block cannot import them; keep the two
      in step). A valid flag marks the document kb-member, and custom.css shows the members-only
      blocks under that class. Without a valid flag a closed page is replaced by the sign-in page,
      with the address the guest asked for in next so that the sign-in can return them, and an
      open page simply stays without the class: the carousel on the home page, the auth pages and
      the 404 page are what a guest can see.

      location.replace, not assignment, so that the closed page does not stay in the history
      behind the sign-in page. The address is path and query only, never the origin, which is also
      the only shape the sign-in page follows.

      What this is not: a lock. Every file of a static site is public, so the HTML of a closed page
      is a curl away, and a flag written by hand shows what curl would show anyway. The data that
      matters is fetched with the visitor's own session and answered by Row Level Security; this
      block only keeps a guest from seeing the frame. */
    }
    {
      /* Reopened on 2026-09-25 after the colleague's review (AUTH.md section 11). The redirect is gone: a guest reads every page, the posts, the videos and
      their comments, as before the gate. What the block still does is mark the document kb-member
      while the flag is valid, which is all custom.css needs to show the one members-only element
      left, the Account item of the menu. Still inline and first in the head, so the item never
      flashes for a guest; still presentation only. */
    }
    <script is:inline define:vars={{ flagKey: site.auth.flagKey }}>
      (function () {
        try {
          var raw = localStorage.getItem(flagKey);
          var expiresAt = raw === null ? NaN : Number(raw);
          if (isFinite(expiresAt) && expiresAt * 1000 > Date.now()) {
            document.documentElement.classList.add("kb-member");
          }
        } catch (_) {}
      })();
    </script>
    {
      /* noindex on every closed page, added late on 2026-09-25 at the owner's word (AUTH.md section
      10): a search engine that runs no scripts would otherwise index the HTML the gate above only
      hides, and a searcher would land on the sign-in page. Open pages (the home page, the auth
      pages, 404) are left as they were; the sitemap in astro.config.mjs lists the home page alone. */
    }
    {
      /* Reopened on 2026-09-25 after the colleague's review (AUTH.md section 11): no page is closed, so the noindex line is gone and the sitemap is back to
      what it was before the gate. */
    }
    <SEO site={seoSite} page={page} />
    <Head title={title} description={description} />
  </head>
  <body class="flex flex-col bg-gray-50 font-bilingual">
    {
      /* The max-w-4xl wrapper that used to live here is now inside Header.astro: it carries
      overflow-x-auto, which would clip the responsive drop-down panel, so the panel has to be
      its sibling. The markup this renders is unchanged. */
    }
    <header class="fixed left-0 top-0 z-30 w-full bg-white shadow-sm">
      <Header />
    </header>

    {
      /* `isolate` on main was added on 2026-09-19 (REVIEW-FIXES.md, section 8). The tag chips
      and the year badges carry z-10/z-20, and with no stacking context between them and the
      root they are painted after the footer. Chromium then rasterises them again, text
      antialiasing included, for as long as a footer icon's hover transform is animating,
      which the reviewer saw as the chip text flickering. With main as its own stacking context
      they are painted where they stand, before the footer. Nothing in main has to stack
      against the header or the footer, so the class changes no picture. Hugo has the same
      flicker. */
    }
    <div class="flex min-h-screen flex-1 flex-col pt-24">
      <main
        class="isolate mx-auto w-full max-w-4xl flex-1 overflow-x-auto px-8 sm:overflow-visible sm:px-10"
      >
        <slot />
      </main>
    </div>

    {
      /* members-only on the footer, added later on the evening of 2026-09-25 at the owner's word: a
      guest sees the carousel, the theme switch and the sign-in, and nothing else, the footer included.
      Hidden by custom.css until the gate above marks the document kb-member (AUTH.md section 10). */
    }
    {
      /* Reopened on 2026-09-25 after the colleague's review (AUTH.md section 11): the footer is for everyone again. */
    }
    <footer
      class="mx-auto w-full max-w-4xl overflow-x-auto px-6 sm:overflow-visible"
    >
      <Footer />
    </footer>

    {
      /* Changed 2026-09-22: the path lost its .js extension when src/scripts/site.js became
      site.ts. Written without an extension rather than as "./site.ts" because TypeScript rejects
      an import path ending in .ts unless allowImportingTsExtensions is set, which this project's
      preset does not set; Vite resolves the extension either way. */
    }
    <script>
      import "../scripts/site";
    </script>

    {
      /* Disqus's comment-count script. Changed 2026-09-22: the shortname was written into the
      address here as a literal, which made this the second place that decided which Disqus
      account the site belongs to - src/config.ts holds the first, and Disqus.astro has read it
      from there since 2026-09-18 (DISQUS-FIX.md). Moving the account to another shortname used
      to mean remembering this line. The protocol-relative "//" went with it: it dates from mixed
      http/https hosting, and the site is https-only.

      The tag keeps its is:inline behaviour either way - Astro implies the directive for any
      script carrying an attribute other than src, and this one carries id and async (Astro 4,
      "Template Directives Reference"). It is written out so that the intent is not a side effect
      of the attribute list. */
    }
    <script
      is:inline
      id="dsq-count-scr"
      src={`https://${site.disqus.shortname}.disqus.com/count.js`}
      async></script>

    <ScrollToTop />
  </body>
</html>
