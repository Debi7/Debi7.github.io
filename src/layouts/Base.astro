---
import "../styles/main.css";
import "../styles/custom.css";

import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import ContactModal from "../components/ContactModal.astro";

import type { SiteConfig, PageLike } from "../lib/seo";
import { site } from "../config";

import {
  getDict,
  getNav,
  getNavValue,
  DEFAULT_LANG,
  type LangType,
  type PageType,
} from "../i18n/strings";

export const locale = (Astro.currentLocale || DEFAULT_LANG) as LangType;
export const t = getDict(locale);
export const nav = getNav(locale);
export const navValue = getNavValue(locale, value);

interface Props {
  title?: string;
  description?: string;
  content?: string;
  isArticle?: boolean;
  isVideo?: boolean;
  publishDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  params?: PageLike["params"];
  noindex?: boolean;
}

const {
  title,
  description,
  content,
  isArticle,
  isVideo,
  publishDate,
  updatedDate,
  tags,
  params,
  noindex,
} = Astro.props;

const seoSite: SiteConfig = {
  title: site.title,
  baseUrl: Astro.site?.toString() ?? "",
  language: site.language,
  avatar: { url: site.avatar },
};

const page: PageLike = {
  title,
  description,
  content,
  permalink: new URL(Astro.url.pathname, Astro.site).toString(),
  isHome: Astro.url.pathname === "/",
  isPage: Boolean(isArticle),
  isVideo: Boolean(isVideo),
  publishDate,
  updatedDate,
  tags,
  params: params ?? {},
};
---

<!doctype html>
<!-- <html lang={site.language} dir="ltr" class="h-full"> -->
<html lang={locale} dir="ltr" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{nav.title}</title>

    <script is:inline type="text/javascript">
      (function (m, e, t, r, i, k, a) {
        m[i] =
          m[i] ||
          function () {
            (m[i].a = m[i].a || []).push(arguments);
          };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) {
            return;
          }
        }
        ((k = e.createElement(t)),
          (a = e.getElementsByTagName(t)[0]),
          (k.async = 1),
          (k.src = r),
          a.parentNode.insertBefore(k, a));
      })(
        window,
        document,
        "script",
        "https://mc.yandex.ru/metrika/tag.js?id=113224698",
        "ym",
      );
      ym(113224698, "init", {
        ssr: true,
        webvisor: true,
        clickmap: true,
        ecommerce: "dataLayer",
        referrer: document.referrer,
        url: location.href,
        accurateTrackBounce: true,
        trackLinks: true,
      });
    </script><noscript
      ><div>
        <img
          src="https://mc.yandex.ru/watch/113224698"
          style="position:absolute; left:-9999px;"
          alt=""
        />
      </div></noscript
    >

    <script is:inline define:vars={{ flagKey: site.auth.flagKey }}>
      (function () {
        try {
          var raw = localStorage.getItem(flagKey);
          var expiresAt = raw === null ? NaN : Number(raw);
          if (isFinite(expiresAt) && expiresAt * 1000 > Date.now()) {
            document.documentElement.classList.add("kb-member");
          }
        } catch (_) {}
      })();
    </script>

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <SEO site={seoSite} page={page} />
    <Head title={title} description={description} />
  </head>

  <body class="flex flex-col bg-gray-50 font-bilingual">
    <header class="fixed left-0 top-0 z-30 w-full bg-white shadow-sm">
      <Header />
    </header>
    <div class="flex min-h-screen flex-1 flex-col pt-24">
      <main
        class="isolate mx-auto w-full max-w-4xl flex-1 overflow-x-auto px-8 sm:overflow-visible sm:px-10"
      >
        <slot />
      </main>
    </div>
    <footer
      class="mx-auto w-full max-w-4xl overflow-x-auto px-6 sm:overflow-visible"
    >
      <Footer />
      <ContactModal />
    </footer>
    <script>
      import "../scripts/site";
    </script>

    <script
      is:inline
      id="dsq-count-scr"
      src={`https://${site.disqus.shortname}.disqus.com/count.js`}
      async></script>

    <ScrollToTop />

    <script>
      document.addEventListener("astro:page-load", () => {
        if (typeof ym === "function") {
          ym(113224698, "hit", window.location.href, {
            title: document.title,
            referrer: document.referrer,
          });
        }
      });
    </script>
  </body>
</html>
