---
// Компонент принимает два обязательных параметра: URL страницы и её уникальный ID (обычно слаг/slug поста)
import { site } from "../config";
interface DisqusConfig {
  page: {
    url: string;
    identifier: string;
  };
}
export interface Props {
  url: string;
  identifier: string;
}

const { url = site.social.github, identifier = "my-post" } = Astro.props;
---

<div id="disqus_thread" class="mt-10 w-full"></div>

<script is:inline define:vars={{ url, identifier }}>
  var disqus_config = function (this: DisqusConfig) {
    this.page.url = url; // Полный URL страницы
    this.page.identifier = identifier; // Уникальный ID (например, 'my-post')
  };

  // const SHORTNAME = "biolocation-club";

  (function () {
    var d = document,
      s = d.createElement("script");
    // s.src = "https://" + SHORTNAME + "://";
    s.src = "https://biolocation-club.disqus.com/embed.js";
    s.setAttribute("data-timestamp", new Date().toString());
    (d.head || d.body).appendChild(s);
  })();
</script>

