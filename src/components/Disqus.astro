---
// Компонент принимает два обязательных параметра: URL страницы и её уникальный ID (обычно слаг/slug поста)
import { site } from "../config";

export interface Props {
  url: string;
  identifier: string;
}

const { url, identifier } = Astro.props;
const { shortname } = site.disqus;
---

<div
  id="disqus_thread"
  class="mt-10 hidden w-full"
  data-disqus-url={url}
  data-disqus-identifier={identifier}
  data-disqus-shortname={shortname}
>
</div>

<script>
  const thread = document.getElementById("disqus_thread");
  const toggleBtn = document.getElementById("toggle-disqus-btn");

  if (!thread || !toggleBtn) {
    return;
  } else {
    const url = thread.dataset.disqusUrl;
    const identifier = thread.dataset.disqusIdentifier;
    const shortname = thread.dataset.disqusShortname;

    let disqusLoaded = false;

    function loadDisqus() {
      if (disqusLoaded || !url || !identifier || !shortname) return;
      disqusLoaded = true;

      (window as any).disqus_config = function (this: any) {
        this.page.url = url;
        this.page.identifier = identifier;
      };

      const embed = document.createElement("script");
      embed.src = `https://${shortname}.disqus.com/embed.js`;
      embed.setAttribute("data-timestamp", new Date().toString());
      (document.head || document.body).appendChild(embed);
    }

    toggleBtn.addEventListener("click", () => {
      const isHidden = thread.classList.contains("hidden");

      if (isHidden) {
        thread.classList.remove("hidden");
        toggleBtn.textContent = "Скрыть комментарии";
        loadDisqus();
      } else {
        thread.classList.add("hidden");
        toggleBtn.textContent = "Показать комментарии";
      }
    });
  }
</script>

<noscript>
  Please enable JavaScript to view the
  <a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a>
</noscript>

{
  // ? Добавьте #disqus_thread к href-атрибуту в ваших ссылках. Это укажет Disqus, какие ссылки
  // искать и возвращать количество комментариев. Например: // <a href="http://foo.com/bar.html#disqus_thread">Link</a>. */
}
