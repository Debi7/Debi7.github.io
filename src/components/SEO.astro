---
// Полная SEO-оптимизация страницы для поисковых систем (Google, Яндекс)
// внутри страницы: title, meta name="description", canonical ссылки, теги для роботов, языковые теги
// Обычно является «родителем» (главным компонентом) для мета-тегов

import type { SiteConfig, PageLike } from "../lib/seo";

import {
  resolveSocialTitle,
  resolveDescription,
  resolveShareImage,
  resolveLocale,
  toIso,
} from "../lib/seo";

interface Props {
  site: SiteConfig;
  page: PageLike;
  // Merged 2026-09-17: the optional title and ogImage props, declared on 2026-09-16 only to be
  // passed on to SocialMeta.astro, are gone. my-saved-work deleted SocialMeta.astro and stopped
  // reading both props here; the title element lives in Head.astro alone.
}

const { site, page } = Astro.props;

const socialTitle = resolveSocialTitle(page, site);
const description = resolveDescription(page, site);
const shareImage = resolveShareImage(page, site);

const canonicalURL = page.permalink || site.baseUrl;
const ogType = page.isPage ? "article" : "website";
const locale = resolveLocale(site);

const publishedTime = toIso(page.publishDate);
const modifiedTime = toIso(page.updatedDate);
const tags = page.tags ?? [];
---

<link rel="canonical" href={canonicalURL} />
<meta name="description" content={description} />

<meta property="og:site_name" content={site.title} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={locale} />
{shareImage && <meta property="og:image" content={shareImage} />}

<meta
  name="twitter:card"
  content={shareImage ? "summary_large_image" : "summary"}
/>
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
{shareImage && <meta name="twitter:image" content={shareImage} />}

{
  page.isPage && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{
  page.isPage && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )
}
{
  page.isPage &&
    tags.map((tag) => <meta property="article:tag" content={tag} />)
}
