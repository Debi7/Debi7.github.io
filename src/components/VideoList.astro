---
import type { ListPage, Video, YearLink } from "../lib/videos";
import { formatMonthDay } from "../lib/date";
import { summary } from "../lib/summary";
import { urlize } from "../lib/urlize";
import { t } from "../i18n/strings";

interface Props {
  title: string;
  page: ListPage<Video>;
  years?: YearLink[];
  currentYear?: string;
}

const { title, page, years, currentYear } = Astro.props;
---

<div class="mx-auto max-w-4xl px-4 py-8">
  <h1 class="mb-8 text-center text-3xl font-bold text-gray-800">{title}</h1>

  {
    years && years.length > 1 && (
      <nav
        aria-label="Years"
        class="-mt-4 mb-8 flex flex-wrap justify-center gap-2"
      >
        {years.map((link) => (
          <a
            href={link.url}
            aria-current={link.year === currentYear ? "true" : undefined}
            class:list={[
              "rounded-md px-3 py-1 text-sm shadow-sm transition-colors",
              link.year === currentYear
                ? "bg-blue-50 text-blue-700 dark:bg-slate-700 dark:text-blue-300"
                : "bg-white text-gray-700 hover:bg-gray-50 dark:bg-slate-900 dark:text-gray-300 dark:hover:bg-slate-800",
            ]}
          >
            {link.year}
          </a>
        ))}
      </nav>
    )
  }

  {
    page.items.length === 0 && (
      <p class="text-center text-gray-500">Пока нет видео.</p>
    )
  }

  <div class="space-y-6">
    {
      page.items.map((video) => (
        <div class="relative">
          <a
            href={`/videos/${video.id}/`}
            class="absolute inset-0 z-10"
            aria-label={video.data.title}
          />
          <div class="group overflow-hidden rounded-lg bg-white shadow-sm transition-shadow duration-300 hover:shadow-md dark:bg-slate-900">
            <div class="p-5">
              <div class="mb-3 flex flex-col justify-between sm:flex-row sm:items-baseline">
                <h3 class="text-xl font-medium text-gray-800 transition-colors group-hover:text-blue-600 dark:text-gray-100">
                  {video.data.title}
                </h3>
                <time class="flex-shrhrink-0 mt-1 flex items-center text-sm text-gray-500 dark:text-gray-400 sm:ml-4 sm:mt-0">
                  {formatMonthDay(video.data.date)}
                </time>
              </div>

              {summary(video.body ?? "") && (
                <div class="line-clamp-2 text-sm text-gray-600 dark:text-gray-300">
                  {summary(video.body ?? "")}
                </div>
              )}

              {video.data.tags.length > 0 && (
                <div class="relative z-20 mt-3 flex flex-wrap gap-2">
                  {video.data.tags.map((tag) => (
                    <a
                      href={`/tags/${urlize(tag)}/`}
                      class="tag-chip rounded bg-gray-100 px-2 py-1 text-xs text-gray-600 transition-colors hover:bg-gray-200 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700"
                    >
                      {tag}
                    </a>
                  ))}
                </div>
              )}

              <div class="mt-4">
                <span class="inline-flex items-center text-sm text-blue-600 transition-transform duration-300 group-hover:translate-x-1">
                  {t.list_read_more}
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="ml-1 h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M14 5l7 7m0 0l-7 7m7-7H3"
                    />
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  {
    (page.prevUrl || page.nextUrl) && (
      <div class="mt-12 flex flex-wrap items-center justify-between gap-y-4 sm:grid sm:grid-cols-[1fr_auto_1fr]">
        {page.prevUrl ? (
          <a
            href={page.prevUrl}
            class="rounded-md bg-white px-4 py-2 text-gray-700 shadow-sm transition-colors hover:bg-gray-50 dark:bg-slate-900 dark:text-gray-300 dark:hover:bg-slate-800 sm:justify-self-start"
          >
            &larr; {t.pagination_previous}
          </a>
        ) : (
          <div />
        )}

        {[page.numbers, page.numbersCompact].map((numbers, index) => (
          <div
            class:list={[
              "order-last w-full flex-wrap justify-center gap-1 sm:order-none sm:w-auto",
              index === 0 ? "hidden sm:flex" : "flex sm:hidden",
            ]}
          >
            {numbers.map((entry) =>
              entry.kind === "gap" ? (
                <span
                  aria-hidden="true"
                  class="px-1 py-1 text-sm text-gray-500 dark:text-gray-400"
                >
                  &hellip;
                </span>
              ) : entry.current ? (
                <span
                  aria-current="page"
                  class="rounded-md bg-blue-50 px-3 py-1 text-sm text-blue-700 shadow-sm dark:bg-slate-700 dark:text-blue-300"
                >
                  {entry.number}
                </span>
              ) : (
                <a
                  href={entry.url}
                  aria-label={t.pagination_page(entry.number)}
                  class="rounded-md bg-white px-3 py-1 text-sm text-gray-700 shadow-sm transition-colors hover:bg-gray-50 dark:bg-slate-900 dark:text-gray-300 dark:hover:bg-slate-800"
                >
                  {entry.number}
                </a>
              ),
            )}
          </div>
        ))}

        {page.nextUrl ? (
          <a
            href={page.nextUrl}
            class="rounded-md bg-white px-4 py-2 text-gray-700 shadow-sm transition-colors hover:bg-gray-50 dark:bg-slate-900 dark:text-gray-300 dark:hover:bg-slate-800 sm:justify-self-end"
          >
            {t.pagination_next} &rarr;
          </a>
        ) : (
          <div />
        )}
      </div>
    )
  }
</div>
