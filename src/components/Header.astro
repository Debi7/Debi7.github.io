---
// Port of ../klub_biolocation/themes/void/layouts/partials/header.html (MIGRATION-PLAN.md §4):
// site title link, the menu, and the theme toggle. Class attributes and the SVG icons are
// copied verbatim; the <header> element itself lives in src/layouts/Base.astro.
//
// This component also owns the max-w-4xl wrapper that used to sit in Base.astro. It was moved
// here on 2026-09-09 for a concrete reason, not for tidiness: that wrapper carries
// `overflow-x-auto`, and `overflow-x: auto` forces `overflow-y` to compute to `auto` as well,
// so a drop-down panel rendered inside it would be clipped instead of hanging below the
// header. The panel therefore has to be the wrapper's SIBLING, which means one component has
// to emit both. The emitted markup is unchanged for the wrapper itself.
//
// Responsive behaviour, added 2026-09-09 at the owner's request (see MIGRATION-PLAN.md §9):
// at 640px and up the header is what Hugo renders - the horizontal menu plus the theme
// toggle. Below 640px both are replaced by a hamburger that opens the panel underneath, and
// the theme toggle moves inside that panel. The behaviour is in src/scripts/site.js.
import Menu from "./Menu.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../config";

// The two icons swap through Tailwind's `hidden` class, not the `hidden` attribute. That is
// deliberate: `hidden` is defined on HTMLElement, and an inline SVG is an SVGElement, so
// `svg.hidden = true` in script sets a plain JavaScript property and changes nothing on the
// page. Measured in a headless browser: the attribute stayed absent and the computed display
// stayed `block`. A class survives the round trip. See src/scripts/site.js.

// "Radiesthesia Club" -> "RC". Derived rather than written down so that renaming the site in
// src/config.ts cannot leave a stale monogram behind.
const initials = site.title
  .split(/\s+/u)
  .filter(Boolean)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
---

<div class="mx-auto w-full max-w-4xl overflow-x-auto px-6 sm:overflow-visible">
  <div class="flex items-center justify-between py-3">
    {
      /* max-w-[70%] below 640px instead of Hugo's max-w-[40%]: the logo takes room the
      wordmark used to have, and with 40% the title truncated to "Radiesthes...". Above 640px
      the class is still sm:max-w-md, exactly as Hugo has it. */
    }
    <div
      class="max-w-[70%] flex-shrink-0 truncate text-lg font-bold sm:max-w-md sm:text-xl"
    >
      <a
        href="/"
        aria-label={site.title}
        class="text-gray-900 no-underline transition-colors hover:text-blue-600 dark:text-gray-100 dark:hover:text-blue-300"
      >
        {
          /* The avatar from the About page, doubling as a logo where the wordmark alone has
          to carry the header. Only below 640px, where the menu is a hamburger; sm:hidden
          makes it display:none above that, so the desktop header stays byte-identical to
          Hugo. It is inline-block rather than a flex child on purpose - turning the anchor
          into a flex container would change how the link itself lays out at every width.
          alt is empty because the link's own text already says the site name; announcing it
          twice is worse than not announcing the image at all. */
        }
        {
          site.avatar && (
            <img
              src={site.avatar}
              alt=""
              width="32"
              height="32"
              class="mr-2 inline-block h-8 w-8 rounded-full object-cover align-middle ring-1 ring-gray-200 dark:ring-slate-700 sm:hidden"
            />
          )
        }
        {
          /* Under 400px even 70% of the header cannot hold the wordmark next to the logo, and
          `truncate` turned it into "Radiesthes...", which reads worse than no wordmark at all.
          Below that width the initials stand in for it. 400px is a judgement call, not a
          measurement: it is roughly where "Radiesthesia Club" stops fitting at text-lg beside a
          32px logo, and `min-[400px]:` is an arbitrary variant so no Tailwind screen had to be
          invented for one rule. The anchor carries aria-label, so the accessible name stays the
          full site title at every width no matter which of the two spans is painted. */
        }
        <span class="min-[400px]:hidden">{initials}</span>
        <span class="hidden min-[400px]:inline">{site.title}</span>
      </a>
    </div>
    <div class="flex items-center gap-2">
      <Menu />
      <ThemeToggle class="ml-2 hidden sm:inline-flex" />

      <button
        id="menu-toggle"
        type="button"
        class="relative inline-flex h-7 w-7 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-gray-700 focus:outline-none dark:text-gray-200 sm:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <svg
          data-menu-icon="open"
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          data-menu-icon="close"
          class="hidden h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<div id="site-menu" class="sm:hidden" hidden>
  <div class="mx-auto w-full max-w-4xl px-6 pb-4">
    <Menu variant="panel" />
    <div
      class="mt-2 flex items-center justify-between border-t border-gray-200 px-2 pt-3 dark:border-slate-700"
    >
      <span class="text-base text-gray-600 dark:text-gray-200">Theme</span>
      <ThemeToggle />
    </div>
  </div>
</div>
