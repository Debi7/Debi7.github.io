---
import Menu from "./Menu.astro";
import ThemeToggle from "./ThemeToggle.astro";
import AuthButton from "./AuthButton.astro";
import SearchNavButton from "./SearchNavButton.astro";
import LangToggle from "./LangToggle.astro";
import { site } from "../config";

const initials = site.title
  .split(/\s+/u)
  .filter(Boolean)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
---

<div
  class="mx-auto w-full max-w-5xl overflow-x-auto px-6 sm:overflow-visible sm:px-3 lg:px-6"
>
  <div class="flex items-center justify-between py-3">
    <div
      class="min-w-0 max-w-[70%] truncate text-lg font-bold sm:max-w-md sm:shrink-[100] sm:text-xl lg:flex-shrink-0"
    >
      <a
        href="/"
        aria-label={site.title}
        class="text-gray-900 no-underline transition-colors hover:text-blue-600 dark:text-gray-100 dark:hover:text-blue-300"
      >
        {
          site.avatar && (
            <img
              src={site.avatar}
              alt=""
              width="32"
              height="32"
              class="mr-2 inline-block h-8 w-8 rounded-full object-cover align-middle ring-1 ring-gray-200 sm:h-6 sm:w-6 dark:ring-slate-700"
            />
          )
        }

        <span class="min-[400px]:hidden">{initials}</span>
        <span class="hidden min-[400px]:inline">{site.title}</span>
      </a>
    </div>

    <div class="flex min-w-0 items-center gap-2">
      <Menu />
      <SearchNavButton />
      <ThemeToggle class="ml-1 inline-flex lg:ml-2" />
      <AuthButton />
      <LangToggle />
    </div>
  </div>
</div>

<div id="site-menu" class="sm:hidden" hidden>
  <div class="mx-auto w-full max-w-5xl px-6 pb-4">
    <Menu variant="panel" />
  </div>
</div>
