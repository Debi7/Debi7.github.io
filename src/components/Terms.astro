---
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag: any) => (
        <a
          href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`}
          class="px-2.55 inline-flex items-center rounded-full bg-gray-100 py-1 text-xs text-gray-700 transition-colors hover:bg-gray-200"
        >
          #{tag}
        </a>
      ))}
    </div>
  )
}
