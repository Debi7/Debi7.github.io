---
import { site } from "../config";
import { locale, nav } from "../layouts/Base.astro";
import { type LangType } from "../i18n/strings";

interface Props {
  variant?: "bar" | "panel";
}

const { variant = "bar" } = Astro.props;

const path = Astro.url.pathname;

function ariaCurrent(url: string): "page" | "true" | undefined {
  if (path === url) return "page";
  if (url !== "/" && path.startsWith(url)) return "true";
  return undefined;
}

const currentClasses = (current: "page" | "true" | undefined) => [
  current === "page" && "active font-bold",
  current === "true" && "ancestor font-semibold",
  current && "bg-blue-50 text-blue-700 dark:bg-slate-700 dark:text-blue-300",
];

const isPanel = variant === "panel";
const accountMark = (url: string) =>
  url === site.auth.account ? "" : undefined;
---

{
  isPanel ? (
    <nav class="w-full" aria-label="Site">
      <ul class="flex list-none flex-col">
        {site.menu.map((item) => (
          <li
            class:list={[
              "text-base text-gray-600 dark:text-gray-200",
              item.url === site.auth.account && "members-only",
            ]}
          >
            <a
              class:list={[
                "block rounded px-2 py-3 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:hover:bg-slate-800 dark:hover:text-white",
                ...currentClasses(ariaCurrent(item.url)),
              ]}
              aria-current={ariaCurrent(item.url)}
              data-menu-account={accountMark(item.url)}
              href={`/${locale} ${item.url}`}
            >
              {nav[locale][item.key as keyof (typeof nav)[LangType]]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ) : (
    // <nav class="hidden w-full justify-end whitespace-nowrap sm:flex">
    //   <ul class="flex list-none flex-row items-center space-x-1 py-2 lg:space-x-3">
    //     {site.menu.map((item) => (
    //       <li
    //         class:list={[
    //           "text-base text-gray-600 hover:text-gray-900 dark:text-gray-200 dark:hover:text-white lg:text-lg",
    //           item.url === site.auth.account && "members-only",
    //         ]}
    //       >
    //         <a
    //           class:list={[
    //             "rounded px-1.5 py-1 transition-colors hover:bg-gray-100 dark:hover:bg-slate-800 lg:py-2",
    //             ...currentClasses(ariaCurrent(item.url)),
    //           ]}
    //           aria-current={ariaCurrent(item.url)}
    //           href={item.url}
    //         >
    //           {item.name}
    //         </a>
    //       </li>
    //     ))}
    //   </ul>
    // </nav>
    // )
    // }

    <nav class="relative hidden w-full min-w-0 justify-end whitespace-nowrap sm:flex">
      <div
        data-menu-scroller
        class="relative flex min-w-0 items-center justify-between overflow-x-auto scrollbar-none"
      >
        <ul class="flex list-none flex-row items-center space-x-1 py-2 sm:max-[793px]:w-max sm:max-[793px]:px-2 lg:space-x-3">
          {site.menu.map((item) => (
            <li
              class:list={[
                "text-base text-gray-600 hover:text-gray-900 lg:text-lg dark:text-gray-200 dark:hover:text-white",
                item.url === site.auth.account && "members-only",
              ]}
            >
              <a
                class:list={[
                  "rounded px-1.5 py-1 transition-colors hover:bg-gray-100 lg:py-2 dark:hover:bg-slate-800",
                  ...currentClasses(ariaCurrent(item.url)),
                ]}
                aria-current={ariaCurrent(item.url)}
                data-menu-account={accountMark(item.url)}
                href={`/${locale} ${item.url}`}
              >
                {nav[locale][item.key as keyof (typeof nav)[LangType]]}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <span
        data-menu-scroll-line
        class="pointer-events-none absolute bottom-0 left-0 right-0 hidden h-0.5 bg-gray-400/20 backdrop-blur-[3px]"
      />
    </nav>
  )
}

<script>
  import { stayOnPage } from "../scripts/same-page";
  const scroller = document.querySelector("[data-menu-scroller]");
  const line = document.querySelector("[data-menu-scroll-line]");
  const list = scroller?.firstElementChild;
  if (
    scroller instanceof HTMLElement &&
    line instanceof HTMLElement &&
    list instanceof HTMLElement
  ) {
    // Tailwind's sm:max-[793px], the band of the list's own classes above.
    const band = window.matchMedia("(min-width: 640px) and (max-width: 793px)");
    const stillPlease = window.matchMedia("(prefers-reduced-motion: reduce)");
    const grab = 6; // px a finger travels before a touch counts as a drag, so a tap stays a tap
    const reach = 15; // px the row can be pulled at most
    let overflowing = false;
    const springs = () => band.matches && !overflowing && !stillPlease.matches;
    const update = () => {
      // A pixel of slack, so that a fractional width rounded up never shows the line on its own.
      overflowing = scroller.scrollWidth - scroller.clientWidth > 1;
      line.classList.toggle("hidden", !overflowing && !band.matches);
      // The nav is a few pixels wider than the row when the row fits (5px to 11px, measured), so
      // the line starts where the row starts, as it did in the colleague's version; 0 when the row
      // overflows, because the row then fills the nav.
      line.style.left = `${scroller.offsetLeft}px`;
      // pan-y leaves the vertical page scroll to the browser and hands the sideways move to the
      // script; without it the browser may claim the gesture and cancel the pointer.
      scroller.style.touchAction = springs() ? "pan-y" : "";
    };
    const observer = new ResizeObserver(update);
    observer.observe(scroller);
    observer.observe(list);
    // The nav too: when the title beside it gives way, the row keeps its size but moves.
    if (line.parentElement) observer.observe(line.parentElement);
    band.addEventListener("change", update);
    stillPlease.addEventListener("change", update);
    update();

    let drag: { id: number; x: number; y: number; moved: boolean } | null =
      null;
    // A drag ends with the finger on a link, which the browser then clicks; that click is dropped.
    let swallowUntil = 0;
    scroller.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "touch" || !springs()) return;
      drag = { id: e.pointerId, x: e.clientX, y: e.clientY, moved: false };
    });
    scroller.addEventListener("pointermove", (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (!drag.moved) {
        // A mostly vertical move is the page scrolling; the row stays out of it.
        if (Math.abs(dy) > grab && Math.abs(dy) >= Math.abs(dx)) {
          drag = null;
          return;
        }
        if (Math.abs(dx) <= grab) return;
        drag.moved = true;
        list.style.transition = "none";
      }
      // tanh gives the resistance: close to the finger at first, never past `reach`.
      list.style.transform = `translateX(${reach * Math.tanh(dx / (reach * 4))}px)`;
    });
    const letGo = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (drag.moved) {
        swallowUntil = performance.now() + 400;
        // An ease that overshoots a little, for the spring.
        list.style.transition =
          "transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)";
        list.style.transform = "";
      }
      drag = null;
    };
    scroller.addEventListener("pointerup", letGo);
    scroller.addEventListener("pointercancel", letGo);
    scroller.addEventListener(
      "click",
      (e) => {
        if (performance.now() < swallowUntil) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true,
    );
  }

  document.querySelectorAll("[data-menu-account]").forEach((account) => {
    if (!(account instanceof HTMLAnchorElement)) return;
    account.addEventListener("click", (event) => {
      stayOnPage(event, account);
    });
  });
</script>

<style>
  /* Скрытие дефолтного скроллбара */
  /* Moved 2026-09-30: the two rules that stood here, hiding the scrollbar of .scrollbar-none, are
     the scrollbar-none utility in tailwind.config.cjs now, where Tailwind knows the class and lets
     it take variants. The note above is kept, as every comment in this project is; the block
     emits nothing. */
</style>
