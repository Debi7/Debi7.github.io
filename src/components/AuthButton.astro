---
import { site } from "../config";
---

<div class="flex flex-1 justify-end">
  <a
    id="auth-link"
    href={site.auth.signIn}
    data-signin-href={site.auth.signIn}
    data-account-href={site.auth.account}
    class="-mr-2 ml-auto flex items-center justify-center gap-7 self-center p-2 text-gray-600 transition-colors hover:text-blue-600"
    aria-label="Войти на сайт"
    title="Войти на сайт"
  >
    <svg
      id="icon-signin"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="h-6 w-6"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75"
      ></path>
    </svg>

    <svg
      id="icon-user"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hidden h-6 w-6"
      aria-hidden="true"
    >
      <circle cx="12" cy="8" r="4"></circle>
      <path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path>
    </svg>
  </a>
</div>

<script>
  import { readAuthFlag } from "../scripts/auth-flag";
  const link = document.getElementById("auth-link");
  const iconSignIn = document.getElementById("icon-signin");
  const iconUser = document.getElementById("icon-user");
  function applyAuthState() {
    if (!(link instanceof HTMLAnchorElement)) return;
    const signInHref = link.dataset.signinHref;
    const accountHref = link.dataset.accountHref;
    if (readAuthFlag()) {
      if (accountHref) link.href = accountHref;
      link.setAttribute("aria-label", "Личный кабинет");
      link.title = "Личный кабинет";
      iconSignIn?.classList.add("hidden");
      iconUser?.classList.remove("hidden");
    } else {
      if (signInHref) link.href = signInHref;
      link.setAttribute("aria-label", "Войти на сайт");
      link.title = "Войти на сайт";
      iconSignIn?.classList.remove("hidden");
      iconUser?.classList.add("hidden");
    }
  }
  applyAuthState();
  window.addEventListener("auth-flag-change", applyAuthState);
  window.addEventListener("storage", applyAuthState);
</script>
