---
// The dark/light switch, lifted out of Header.astro on 2026-09-09 (MIGRATION-PLAN.md §4).
//
// Why it is its own component now: below 640px the header row is replaced by a hamburger and
// the switch moves into the drop-down panel, so the document carries two of these buttons and
// a breakpoint decides which one is displayed. Duplicating forty lines of SVG in two places
// was the alternative.
//
// The markup and both icons are still verbatim from
// ../klub_biolocation/themes/void/layouts/partials/header.html, with one change: the button no
// longer carries id="theme-toggle". An id has to be unique and there are two instances now.
// Nothing visual depended on it - the theme's CSS hooks on the .theme-toggle and
// .theme-toggle-btn classes, never on the id (src/styles/main.css, lines 848-935) - and
// src/scripts/site.js now binds every [data-theme-toggle] and keeps their aria state in sync.

interface Props {
  /** Extra classes, used to hide one instance at a breakpoint. */
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  data-theme-toggle
  type="button"
  class:list={[
    "theme-toggle theme-toggle-btn relative inline-flex h-7 w-7 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-gray-700 focus:outline-none dark:text-gray-200",
    className,
  ]}
  aria-label="Toggle dark mode"
  aria-pressed="false"
>
  <!-- Light icon (provided) -->
  <svg
    class="icon-sun h-full w-full"
    viewBox="0 0 1024 1024"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M512 192c179.2 0 320 140.8 320 320s-140.8 320-320 320-320-140.8-320-320S332.8 192 512 192M512 128C300.8 128 128 300.8 128 512s172.8 384 384 384 384-172.8 384-384S723.2 128 512 128L512 128z"
      fill="currentColor"></path>
    <path
      d="M544 416l236.8 0C774.4 403.2 768 384 761.6 371.2L544 371.2 544 416z"
      fill="currentColor"></path>
    <path
      d="M544 608l0 44.8 217.6 0c6.4-12.8 12.8-32 19.2-44.8L544 608z"
      fill="currentColor"></path>
    <path
      d="M544 723.2 544 768 640 768c25.6-12.8 44.8-25.6 64-44.8L544 723.2z"
      fill="currentColor"></path>
    <path
      d="M800 492.8l-256 0 0 44.8 256 0c0-6.4 0-12.8 0-25.6S800 499.2 800 492.8z"
      fill="currentColor"></path>
    <path
      d="M544 300.8 704 300.8c-19.2-19.2-38.4-32-64-44.8L544 256 544 300.8z"
      fill="currentColor"></path>
  </svg>
  <!-- Dark icon (provided) -->
  <svg
    class="icon-moon h-full w-full"
    viewBox="0 0 1024 1024"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M512 832c-179.2 0-320-140.8-320-320s140.8-320 320-320 320 140.8 320 320S691.2 832 512 832M512 896c211.2 0 384-172.8 384-384s-172.8-384-384-384S128 300.8 128 512 300.8 896 512 896L512 896zM800 512c0-160-128-288-288-288l0 576C672 800 800 672 800 512zM480 608 243.2 608C249.6 620.8 256 640 262.4 652.8l217.6 0L480 608zM480 416 480 371.2 262.4 371.2C256 384 249.6 403.2 243.2 416L480 416zM480 300.8 480 256 384 256C358.4 268.8 339.2 281.6 320 300.8L480 300.8zM224 537.6l256 0L480 492.8l-256 0c0 6.4 0 12.8 0 19.2S224 524.8 224 537.6zM480 723.2 320 723.2c19.2 19.2 38.4 32 64 44.8l96 0L480 723.2z"
      fill="currentColor"></path>
  </svg>
</button>
