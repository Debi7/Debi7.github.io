---
import { site } from "../config";

// Получаем социальные ссылки из конфигурации
const social = site.social;

// Считаем, сколько социальных ссылок настроено
const socialLinks = Object.values(social).filter(Boolean);
const socialCount = socialLinks.length;

// Определяем класс для контейнера соц. ссылок
const socialContainerClass =
  socialCount === 1 ? "flex justify-center" : "flex justify-center space-x-8";
---

<div class="mt-10 border-t border-gray-200 bg-gray-50 py-8 shadow-inner">
  <div class="container mx-auto max-w-4xl px-4">
    <!-- Социальные ссылки -->
    <div class={socialContainerClass}>
      <!-- GitHub -->
      {
        social.github && (
          <div class="transform transition duration-200 hover:scale-110">
            <a
              href={social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-600 hover:text-gray-900"
              aria-label="GitHub"
            >
              <svg
                class="h-7 w-7"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 11.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          </div>
        )
      }

      <!-- Telegram -->
      {
        social.telegram && (
          <div class="transform transition duration-200 hover:scale-110">
            <a
              href={social.telegram}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-600 hover:text-gray-900"
              aria-label="Telegram"
            >
              <svg
                class="h-7 w-7"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M23.91 3.79L20.3 20.84c-.25 1.21-.98 1.5-2 .94l-5.5-4.07-2.66 2.57c-.3.3-.55.56-1.1.56-.72 0-.6-.27-.84-.95L6.3 13.7l-5.45-1.7c-1.18-.35-1.19-1.16.26-1.75l21.26-8.2c.97-.43 1.9.24 1.53 1.73z" />
              </svg>
            </a>
          </div>
        )
      }

      <!-- Email -->
      {
        social.email && (
          <div class="transform transition duration-200 hover:scale-110">
            <a
              href={`mailto:${social.email}`}
              rel="noopener noreferrer"
              class="text-gray-600 hover:text-gray-900"
              aria-label="Email"
            >
              <svg
                class="h-7 w-7"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z" />
                <path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z" />
              </svg>
            </a>
          </div>
        )
      }
    </div>

    <!-- Копирайт -->
    <div class="mt-6 text-center text-sm text-gray-500">
      &copy; {new Date().getFullYear()}
      {site.title} | Powered by <a
        href="https://github.com/Dauaucloud/hugo-theme-void"
        class="text-gray-600 hover:text-gray-900 hover:underline"
        >hugo-theme-void</a
      >
      <span id="busuanzi_container_site_pv" style="display: none;">
        | Total visits: <span id="busuanzi_value_site_pv" class="text-gray-600"
        ></span>
      </span>
    </div>
    {
      /* busuanzi loader now lives in Head.astro, as in the Hugo theme: partials/footer.html
    carries the same note, and head.html loads it early so the page view counter renders without
    a delay. The counter itself is the two spans above, which the loader fills in.
    Changed 2026-09-16: the loader element that used to sit here had its opening tag closed
    before the src attribute, so the URL became the element text and nothing was ever loaded; it
    also broke the Vite pre-scan and Prettier. The unused busuanziScript constant in the
    frontmatter, which held the same tag in a template literal, went with it. The broken markup
    is deliberately not kept as a comment: a literal script tag inside a comment is what breaks
    the pre-scan.
    Changed 2026-09-17: this was an HTML comment, which is sent to every visitor; it is an Astro
    comment now, like the other comments added to the markup. */
    }
  </div>
</div>

<!-- TODO Подключить счетчик посещений (например, Яндекс.Метрику или Google
Analytics) в Astro можно двумя основными способами: обычным добавлением скрипта
в базовый шаблон (Layout) или с помощью оптимизации через библиотеку Partytown,
чтобы внешние скрипты не замедляли загрузку сайта.
Существуют сторонние комьюнити-компоненты, такие как astro-yandex-metrika, 
позволяющие вынести ID счетчика в переменные окружения (import.meta.env) -->
