---
// TODO (миграция §4): порт ../klub_biolocation/themes/void/layouts/partials/social_meta.html
// (Open Graph + теги Twitter). Astro.site (astro.config.mjs) заменяет .Site.BaseURL.

// Оптимизация внешнего вида ссылок в соцсетях и мессенджерах
// Теги Open Graph (для Facebook, VK, Telegram) и Twitter Cards
// Часто импортируется внутрь компонента SEO.astro

interface Props {
  /**
   * Changed 2026-09-16 so that astro check passes: `title` became optional because SEO.astro
   * renders this component a second time with the page title it received, which may be
   * undefined, and `ogImage` was already being passed but never declared. Both are type-only
   * changes; the rendered tags are unchanged, including the empty og:title of that second copy.
   * The duplication itself is still open - see ARTICLE-PAGE-FIX.md, section 7.1.
   */
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---

{description && <meta name="description" content={description} />}

<!-- Open Graph / Facebook / Telegram -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:title" content={title} />
