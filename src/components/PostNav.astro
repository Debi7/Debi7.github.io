---
// Changed 2026-09-16: the two labels below read t.<key>. `t` in src/i18n/strings.ts is an
// object, not a function, so the t("key") calls this file used to have threw "t is not a
// function" the moment the component rendered.
//
// Changed 2026-09-22: the two links come in as plain NavLinks (lib/lists.ts), an address and
// a title, built by postLink() for a post page and videoLink() for a video page, so this
// component knows no collection. Until then it took the entries and built /posts/<slug>/
// itself, which sent the previous and next video to a page that does not exist; see
// VIDEO-PAGE.md, section 4.
import { t } from "../i18n/strings";
import type { NavLink } from "../lib/lists";

interface Props {
  prev: NavLink | null;
  next: NavLink | null;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {prev && (
        <a
          href={prev.url}
          class="group block rounded-lg border border-gray-200 bg-white p-4 transition-colors hover:border-blue-300 hover:bg-blue-50/30"
        >
          <div class="mb-1 flex items-center text-xs text-gray-500">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="mr-1.5 h-4 w-4 text-gray-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19l-7-7 7-7"
              />
            </svg>
            {t.pagination_previous}
          </div>
          <div class="line-clamp-2 text-sm font-medium text-gray-900 group-hover:text-blue-700">
            {prev.title}
          </div>
        </a>
      )}

      {next && (
        <a
          href={next.url}
          class="group block rounded-lg border border-gray-200 bg-white p-4 transition-colors hover:border-blue-300 hover:bg-blue-50/30 sm:col-start-2 sm:text-right"
        >
          <div class="mb-1 flex items-center text-xs text-gray-500 sm:justify-end">
            <span class="mr-0 sm:order-1 sm:ml-1">{t.pagination_next}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="ml-1.5 h-4 w-4 text-gray-400 sm:order-2 sm:ml-1 sm:mr-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </div>
          <div class="line-clamp-2 text-sm font-medium text-gray-900 group-hover:text-blue-700">
            {next.title}
          </div>
        </a>
      )}
    </nav>
  )
}
