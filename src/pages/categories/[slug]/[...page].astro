---
// One category, e.g. /categories/blog/. Hugo has no category-specific template, so it falls
// back to ../klub_biolocation/themes/void/layouts/_default/list.html - the same one /posts/
// uses, which is why this route renders CardList.astro with a different title.
// MIGRATION-PLAN.md §4.1.
//
// Nothing links here: the Categories page is an accordion that expands in place and links
// straight to the posts. These pages exist only because Hugo generates them, and they are
// kept for URL parity.
//
// Changed 2026-09-19, asked for by the owner: the list is paginated, like /posts/. This file
// was src/pages/categories/[slug].astro. As a rest-parameter route it renders page 1 at
// /categories/<slug>/ and page n at /categories/<slug>/page/<n>/, Hugo's shape. The page
// links are built from the encoded slug, like every other hand-built link to a term page
// (see encodeSlug in lib/urlize.ts).
//
// Changed later on 2026-09-19, asked for by the owner: the list is split by year like /posts/,
// through the same paginateByYear() - /categories/<slug>/ is the newest year's first page,
// /categories/<slug>/<year>/ a year, /categories/<slug>/<year>/page/<n>/ a further page of
// it - and gets the year switcher, which until then was on /posts/ only. See PAGINATION.md.
import type { InferGetStaticPropsType } from "astro";
import Base from "../../../layouts/Base.astro";
// Changed 2026-09-22 (VIDEO-PAGE.md, section 4): the list component is CardList.astro (it was
// PostList.astro) and renders Cards, plain data this route builds with postCard(); the split by
// year comes from lib/lists.ts, shared with the Video list.
import CardList from "../../../components/CardList.astro";
import { getTerms, postCard } from "../../../lib/posts";
import { paginateByYear } from "../../../lib/lists";
import { encodeSlug } from "../../../lib/urlize";

export async function getStaticPaths() {
  const terms = await getTerms("categories");
  return terms.flatMap((term) =>
    paginateByYear(
      term.posts.map(postCard),
      `/categories/${encodeSlug(term.slug)}/`,
    ).map((entry) => ({
      params: { slug: term.slug, page: entry.param },
      props: { term, ...entry },
    })),
  );
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { term, page, years, year } = Astro.props;
---

<Base title={term.title}>
  <CardList title={term.title} page={page} years={years} currentYear={year} />
</Base>
