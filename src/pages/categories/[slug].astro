---
// One category, e.g. /categories/blog/. Hugo has no category-specific template, so it falls
// back to ../klub_biolocation/themes/void/layouts/_default/list.html - the same one /posts/
// uses, which is why this route renders PostList.astro with a different title.
// MIGRATION-PLAN.md §4.1.
//
// Nothing links here: the Categories page is an accordion that expands in place and links
// straight to the posts. These pages exist only because Hugo generates them, and they are
// kept for URL parity.
import type { InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getTerms } from "../../lib/posts";

export async function getStaticPaths() {
  const terms = await getTerms("categories");
  return terms.map((term) => ({
    params: { slug: term.slug },
    props: { term },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { term } = Astro.props;
---

<Base title={term.title}>
  <PostList title={term.title} posts={term.posts} />
</Base>
