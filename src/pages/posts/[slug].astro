---
import type { InferGetStaticPropsType } from "astro";
import Post from "../../layouts/Post.astro";
import { getPosts } from "../../lib/posts";
import Disqus from "../../components/Disqus.astro";
// Changed 2026-09-17: this import is no longer needed here, see the note above postUrl below.
// import { site } from "../../config";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, next: posts[i - 1] ?? null, prev: posts[i + 1] ?? null },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, prev, next } = Astro.props;
const { Content, headings } = await post.render();

// Формируем полный URL для Disqus.
// Astro.site берется из настройки site в astro.config.mjs
//
// Changed 2026-09-17: the address was built from site.social.github, the link shown in the
// footer, so the built page carried https://debi7.github.io//posts/article - a double slash and
// no trailing slash. Disqus keys a thread by this URL, so it has to be the page's own address,
// the same one the canonical link carries. The previous line is kept here:
//
// const postUrl = `${site.social.github}/posts/${post.slug}`;
const postUrl = new URL(`/posts/${post.slug}/`, Astro.site).toString();
const postIdentifier = post.slug;
---

<Post post={post} headings={headings} prev={prev} next={next}>
  <Content />
  <hr class="my-8 border-gray-200" />
  <Disqus url={postUrl} identifier={postIdentifier} />
</Post>
