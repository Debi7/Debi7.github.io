---
import Base from "../../layouts/Base.astro";
import VideoList from "../../components/VideoList.astro";
import {
  getVideos,
  groupByYear,
  pageParam,
  paginateList,
  yearLinks,
} from "../../lib/videos";

const title = "Видео";

export async function getStaticPaths() {
  const groups = groupByYear(await getVideos());
  const years = yearLinks(groups);

  const yearPages = groups.flatMap((group) =>
    paginateList(group.videos, `/videos/${group.year}/`).map((page) => ({
      params: { video: pageParam(page.number, group.year) },
      props: { page, years, currentYear: group.year },
    })),
  );

  const allVideos = groups.flatMap((g)) => g.videos);
  const mainPages = paginateList(allVideos, "/videos/").map((page) => ({
    params: { video: pageParam(page.number) },
    props: { page, years, currentYear: undefined },
  }));

  return [...mainPages, ...yearPages];
}

type Props = {
  page: ReturnType<typeof paginateList>[number];
  years: ReturnType<typeof yearLinks>;
  currentYear?: string;
};

const { page, years, currentYear } = Astro.props;
---

<Base title={title}>
  <VideoList
    title={title}
    page={page}
    years={years}
    currentYear={currentYear}
  />
</Base>
