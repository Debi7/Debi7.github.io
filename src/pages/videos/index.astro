---
import type { InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import VideoList from "../../components/VideoList.astro";
import {
  getVideos,
  groupByYear,
  videoParam,
  paginateList,
  yearLinks,
} from "../../lib/videos";

const title = "Videos";

export async function getStaticPaths() {
  const groups = groupByYear(await getVideos());
  const years = yearLinks(groups);
  const yearVideos = groups.flatMap((group) =>
    paginateList(group.videos, `/video/${group.year}/`).map((video) => ({
      params: { video: videoParam(video.number, group.year) },
      props: { video, years, year: group.year },
    })),
  );

  const newest = yearVideos.at(0);
  const home = newest
    ? { params: { video: undefined }, props: newest.props }
    : {
        params: { video: undefined },
        props: {
          video: paginateList([], "/video/")[0],
          years,
          year: undefined,
        },
      };
  return [home, ...yearVideos];
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { video, years, year } = Astro.props;
---

<Base title={title}>
  <VideoList title={title} video={video} years={years} currentYear={year} />
</Base>
