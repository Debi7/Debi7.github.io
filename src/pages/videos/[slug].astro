---
import { type CollectionEntry, getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const videos = await getCollection("videos");
  return videos.map((video) => ({
    params: { slug: video.id },
    props: { video },
  }));
}

type Props = { video: CollectionEntry<"videos"> };

const { video } = Astro.props;
const { Content } = await video.render();
---

<Base title={video.data.title} description={video.data.description}>
  <article class="rounded-xl bg-white p-6 shadow-sm md:p-8">
    <h1 class="mb-4 text-3xl font-bold md:text-4xl">{video.data.title}</h1>

    {
      video.data.videoUrl && (
        <div class="mb-8 aspect-video w-full overflow-hidden rounded-lg shadow-lg">
          <iframe
            src={video.data.videoUrl}
            class="h-full w-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      )
    }

    <div class="prose max-w-none">
      <Content />
    </div>
  </article>
</Base>
