---
import type { InferGetStaticPropsType } from "astro";
import Video from "../../layouts/Post.astro";
import { getVideo } from "../../lib/video";
import Disqus from "../../components/Disqus.astro";

export async function getStaticPaths() {
  const videoArr = await getVideo();
  return videoArr.map((videoItem, i) => ({
    params: { slug: videoItem.slug },
    props: {
      videoItem,
      next: videoArr[i - 1] ?? null,
      prev: videoArr[i + 1] ?? null,
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { videoItem, prev, next } = Astro.props;
const { Content, headings } = await videoItem.render();

const videoUrl = new URL(`/video/${videoItem.slug}/`, Astro.site).toString();
const videoId = videoItem.slug;
---

<Video post={videoItem} headings={headings} prev={prev} next={next}>
  {
    /* тут можно закрыть доступ к конкретным лекциям: если пользователь не оплатил, вместо iframe от YouTube будет показываться красивая заглушка «Купить курс за ХХХ рублей», а если оплатил — будет рендериться сам плеер */
  }
  <div class="video-wrapper mb-8">
    {
      /* The address read `youtube.com{post.data.videoId}` until 2026-09-22: no `/embed/`
      path, no `$` before the brace and a variable that does not exist in this file, so the
      frame asked for that text as a host name and the browser showed "server not found".
      YouTube's embeddable player lives at www.youtube.com/embed/<id>. VIDEO-PAGE.md, section 2. */
    }
    <iframe
      class="aspect-video w-full rounded-xl shadow-lg"
      src={`https://www.youtube.com/embed/${videoItem.data.videoId}`}
      title={videoItem.data.title}
      allowfullscreen
    >
    </iframe>
  </div>

  <Content />
  <hr class="my-8 border-gray-200" />

  <div id="disqus_loader_container" class="my-6 flex flex-col items-center">
    <button
      id="toggle-disqus-btn"
      class="rounded px-2 py-1 text-base text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-200 dark:hover:bg-slate-800 dark:hover:text-white md:px-3 md:py-2 md:text-lg"
    >
      Показать комментарии
    </button>
  </div>
  <Disqus url={videoUrl} identifier={videoId} />
</Video>
