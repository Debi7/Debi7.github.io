---
// One video, /video/<slug>/, rendered through VideoLayout.astro: the player, then the body,
// then the comments. Since 2026-09-22; until then it rendered through Post.astro with the
// player in this file (VIDEO-PAGE.md, section 4). The previous and next links walk the videos
// in getVideos() order, newest first, as posts/[slug].astro does for the posts. The comments
// block is the post page's, with the video's address and slug as the Disqus thread; the slug
// variable was `videoId` and is `videoIdentifier`, so that it is not mistaken for the YouTube
// id in the front matter.
import type { InferGetStaticPropsType } from "astro";
import VideoLayout from "../../layouts/VideoLayout.astro";
import { getVideos, videoUrl } from "../../lib/video";
import Disqus from "../../components/Disqus.astro";

export async function getStaticPaths() {
  const videos = await getVideos();
  return videos.map((video, i) => ({
    params: { slug: video.slug },
    props: { video, next: videos[i - 1] ?? null, prev: videos[i + 1] ?? null },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { video, prev, next } = Astro.props;
const { Content, headings } = await video.render();

// Changed 2026-09-22: the address comes from videoUrl() in lib/video.ts, which is where a video's
// address is decided - the list cards and the previous/next links already go through it - instead
// of being assembled here from the slug. The Disqus thread is keyed by this URL, so a copy of the
// pattern left behind in this file would orphan every comment on a video the day /video/ moves.
// The local name is commentsUrl, since videoUrl is now the imported function; the videoIdentifier
// alias is gone, because passing video.slug directly says what the alias was there to say (the
// header note below explains why it was not called videoId).
const commentsUrl = new URL(videoUrl(video), Astro.site).toString();
---

<VideoLayout video={video} headings={headings} prev={prev} next={next}>
  <Content />
  <hr class="my-8 border-gray-200" />

  {
    /* Changed 2026-09-22: the reveal button that stood here moved into Disqus.astro, next to the
    script that binds to it; this file was one of the two copies of that block. The rendered
    markup is unchanged. */
  }
  {
    /* Changed 2026-09-28, the owner's choice: on a paid video the comments stay hidden until the
    access service has answered 200 (Disqus.astro, the locked prop). */
  }
  {
    /* Changed later on 2026-09-28, the owner's decision: on a paid video the comments are closed
    to a guest only. They show as soon as the page has confirmed that the visitor is signed in,
    access or not, so that someone who has not paid yet can be instructed there; the player and
    the members-only block (block 2, lib/video.ts) still wait for access. `locked` means "until
    signed in" now (Disqus.astro). */
  }
  <Disqus
    url={commentsUrl}
    identifier={video.slug}
    locked={video.data.access === "paid"}
  />
</VideoLayout>
