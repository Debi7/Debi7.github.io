---
// The Video list: /video/, /video/<year>/ and /video/<year>/page/<n>/, the same shape as
// the Posts list in posts/[...page].astro, fed by the `video` collection through
// src/lib/video.ts and rendered by VideoList.astro.
//
// Fixed on 2026-09-22 (VIDEO-PAGE.md, section 2): the rest parameter of this route is named
// `video`, after the file, but getStaticPaths returned `params: { page: ... }`, copied from
// the Posts route. Astro ignores a param the route does not declare, so every entry mapped
// to /video/, the last one written - the oldest year - was what that page showed, and no
// year page existed. The keys read `video` now.
import type { InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import VideoList from "../../components/VideoList.astro";
import {
  getVideo,
  groupByYear,
  pageParam,
  paginateList,
  yearLinks,
} from "../../lib/video";

import { getCollection } from "astro:content";
const video = await getCollection("video");

const title = "Video";

export async function getStaticPaths() {
  const groups = groupByYear(await getVideo());
  const years = yearLinks(groups);
  const yearPages = groups.flatMap((group) =>
    paginateList(group.videoArr, `/video/${group.year}/`).map((page) => ({
      // `video`, not `page`: the name of this route's rest parameter (see the note above).
      params: { video: pageParam(page.number, group.year) },
      props: { page, years, year: group.year },
    })),
  );

  const newest = yearPages.at(0);
  const home = newest
    ? { params: { video: undefined }, props: newest.props }
    : {
        params: { video: undefined },
        props: {
          page: paginateList([], "/video/")[0],
          years,
          year: undefined,
        },
      };
  return [home, ...yearPages];
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, years, year } = Astro.props;
---

<Base title={title}>
  <VideoList title={title} page={page} years={years} currentYear={year} />
</Base>
