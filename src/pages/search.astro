---
// The search page, /search/. Added 2026-09-22 at the owner's request, after the reference site he
// sent (daucloud.com) - the same family of theme as the one this port copies - put a magnifier in
// its header leading to a page of its own. The owner chose a page over a drop-down panel for the
// same reason that site does: a result list needs room, it has to survive a reload, and a search
// worth sharing has to have an address.
//
// Nothing is searched here, at build time: this page is markup, and src/scripts/search.ts does the
// work in the browser against /search-index.json. That split is what keeps the index out of every
// other page of the site - the script is imported here and nowhere else, so only this page loads
// it.
//
// The Hugo theme has no search page to port. What it does have is the string below,
// `search_placeholder` in themes/void/i18n/en.toml, which was ported with the rest of the file and
// had never been used; the wording of everything else on this page is written here, in English,
// like the rest of the site's chrome. It is not put into src/i18n/strings.ts because that file is
// the theme's en.toml and nothing else - inventing keys in it would make it look as if the theme
// defines them.
// The stylesheet stands in a file of its own, and that is not tidiness. Astro scopes a <style>
// block by stamping a data attribute onto the elements the COMPONENT renders, and every result on
// this page is built by search.ts in the browser, so those elements carry no such attribute and a
// scoped rule never matches them - measured on 2026-09-22, when the results came out as unstyled
// text with the browser's yellow mark. A plain .css file is global, like src/styles/carousel.css,
// which is the same situation: markup that CSS has to reach without the compiler knowing about it.
import "../styles/search.css";
import Base from "../layouts/Base.astro";
import { t } from "../i18n/strings";

const title = "Search";
---

<Base title={title} description="Search the articles and the video lectures.">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <h1 class="mb-8 text-center text-3xl font-bold text-gray-800">{title}</h1>

    {
      /* A form and not a bare input, so Enter submits and a phone shows a search key on its
      keyboard. The script cancels the submit - there is nowhere to submit to on a static site -
      and writes the query into the address bar itself. action and method stay off for the same
      reason: without JavaScript this form has nothing to send, and the note below says so. */
    }
    <form id="search-form" class="mx-auto max-w-2xl" role="search">
      <label class="sr-only" for="search-input">{title}</label>
      <div class="relative">
        <input
          id="search-input"
          name="q"
          type="search"
          autocomplete="off"
          placeholder={t.search_placeholder}
          class="w-full rounded-lg border border-gray-200 bg-white px-4 py-3 pr-12 text-base text-gray-800 shadow-sm outline-none transition-colors focus:border-blue-500 dark:border-slate-700 dark:bg-slate-900 dark:text-gray-100"
        />
        <svg
          class="pointer-events-none absolute right-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
      </div>
    </form>

    {
      /* aria-live, so a screen reader is told how many results appeared without the focus leaving
      the input. The four messages are data attributes rather than strings inside the script: the
      wording belongs to the page, and {n} and {q} are filled in by search.ts. */
    }
    <p
      id="search-status"
      class="mt-6 text-center text-sm text-gray-600 dark:text-gray-300"
      aria-live="polite"
      data-searching="Searching..."
      data-found='{n} result(s) for "{q}"'
      data-empty='Nothing found for "{q}"'
      data-failed="The search index could not be loaded. Please try again."
    >
    </p>

    <noscript>
      <p
        class="mt-6 text-center text-sm text-gray-600 dark:text-gray-300"
        set:html="Search needs JavaScript, because this site is static and there is no server to ask. The sections are browsable without it: Posts, Video, Categories and Tags."
      />
    </noscript>

    <ul id="search-results" class="mx-auto mt-8 max-w-2xl list-none space-y-4">
    </ul>
  </div>
</Base>

{
  /* Top level of the template on purpose. A bundled script inside a {...} expression is not
  hoisted into the page bundle at all - measured on 2026-09-22 while moving the carousel's script
  out of its component - and the script itself returns at once when the form is absent. */
}
<script>
  import "../scripts/search";
</script>
