---
// /auth/signup/ - registration, through Clerk's sign-up component.
//
// Rewritten on 2026-09-26 for the move to Clerk (CLERK.md step 5; the verdict in
// .specify/consilium/2026-09-25-clerk-static.md). The hand-written form and its handler are gone:
// Clerk's component renders the fields, checks the password rule, sends the verification code by
// mail and takes it back, all inside the element below. The previous page's comments went with it
// (CLERK.md section 0); the lessons that do not depend on the provider are kept here.
//
// A static page on GitHub Pages, which serves files and runs no server; everything happens in the
// visitor's browser, in the script block below. That is also why @clerk/astro is not used: every
// version of it needs server output (the verdict, "Limits and constraints").
//
// routing "hash", never "path": Clerk's sub-steps (the code entry, for instance) would otherwise be
// sub-addresses such as /auth/signup/verify-email-address/, which a static host answers with 404.
// With "hash" they live in the fragment of this one page.
//
// The password rule (at least 8 characters, the owner's decision of 2026-09-25) and the choice of
// verification by code are set in the Clerk Dashboard, not here (CLERK.md section 1; the component
// reads them from the instance). A change to either is a Dashboard change.
//
// The page is inside Base.astro on the owner's decision of 2026-09-25: it has no Hugo counterpart
// and no parity to keep, so it borrows the site's header and theme. The strings are Russian, the
// language of the site (site.language in src/config.ts); they are written here rather than in
// src/i18n/strings.ts, which is the Hugo theme's en.toml and nothing else. Clerk's own strings come
// from @clerk/localizations (ruRU, set in src/scripts/auth.ts).
//
// Colours: red-600 for the error line, as on the pages this one replaced; it is not pinned to a
// Tailwind 4 value because Hugo never printed an error.
import Base from "../../layouts/Base.astro";
---

<Base title="Регистрация">
  <section class="mx-auto max-w-md">
    <h1 class="mb-6 text-2xl font-bold">Регистрация</h1>
    <div id="clerk-signup"></div>
    <p id="auth-status" class="mt-4 text-sm" role="status" aria-live="polite">
      Загрузка...
    </p>
    <noscript>
      <p class="text-sm">Для регистрации нужен включённый JavaScript.</p>
    </noscript>
  </section>
</Base>

<script>
  // Top level of the template, never inside an expression: a bundled script there is not hoisted
  // at all (CLAUDE.md, measured 2026-09-22).
  import { getClerk, showLoadFailure } from "../../scripts/auth";
  import { site } from "../../config";

  const root = document.getElementById("clerk-signup");
  const status = document.getElementById("auth-status");

  try {
    const clerk = await getClerk();
    if (clerk.isSignedIn) {
      // Already a member: registering again makes no sense, the account page is where they belong.
      location.replace(site.auth.account);
    } else if (root instanceof HTMLDivElement) {
      clerk.mountSignUp(root, {
        routing: "hash",
        signInUrl: site.auth.signIn,
        forceRedirectUrl: site.auth.account,
      });
      status?.remove();
    }
  } catch (error) {
    showLoadFailure(status, error);
  }
</script>
