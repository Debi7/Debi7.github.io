---
// /auth/account/ - the member's page: Clerk's profile component, a sign-out button, one demo line.
//
// Added 2026-09-26 for the move to Clerk (CLERK.md step 5), in place of /auth/dashboard/. The
// `Account` menu item opens it, and a sign-in or a registration lands here. signup.astro carries
// the reasoning the three auth pages share; the part that is this page's own follows.
//
// Clerk's profile component covers what the dashboard's own links did and more: the email address,
// the password change, the list of active sessions. It is mounted with routing "hash" for the same
// reason as the forms.
//
// The demo line. It is hidden in the markup and shown only when the signed-in user's
// publicMetadata.member is true. publicMetadata can be written only from the Clerk Dashboard or
// Clerk's Backend API, never from the visitor's browser, which is why it may decide anything at
// all; unsafeMetadata, which the browser can write, must never be used for this. It is the record
// the paid content will read later (CLERK-DASHBOARD.md section 7.3); on this page it is still
// presentation, because the HTML of a static site is public and a lock needs a server-side check
// (CLERK-DASHBOARD.md section 5).
//
// A guest is sent to the sign-in page with this page as `next`, so they come back after signing
// in. The redirect is the script's, not the frontmatter's: at build time there is no visitor.
import Base from "../../layouts/Base.astro";
// Added 2026-09-26: Clerk's components in the site's colours and font (src/styles/clerk.css says
// how). Imported here, as carousel.css and search.css are by the pages that need them.
import "../../styles/clerk.css";
// Added 2026-10-02: the addresses of the two panel pages, linked for a metr or an admin.
import { site } from "../../config";
// Added 2026-10-12 with the two interface languages (src/i18n/lang.ts): the page's own words in
// both languages, through T in the markup and the templates and through phrase() in the script.
// Clerk's card takes its language once, when it loads (Clerk's "Localization prop", Core 3), so a
// language switch on this page reloads it (reloadOnLanguageChange() in src/scripts/auth.ts), and
// the script writes its texts in the language the page loaded in.
import { ui } from "../../i18n/strings";
import { langAttrs } from "../../i18n/lang";
import T from "../../components/T.astro";
---

{
  /* Changed 2026-10-12: here and below, every Russian text of the page in both languages (the note
in the frontmatter); the Russian texts that stood here are the ru halves in src/i18n/strings.ts. */
}
<Base title={ui.auth_account}>
  <section class="mx-auto max-w-3xl">
    <h1 class="mb-6 text-2xl font-bold"><T s={ui.auth_account} /></h1>
    <p id="auth-status" class="text-sm" role="status" aria-live="polite">
      <T s={ui.auth_loading} />
    </p>
    <noscript>
      <p class="text-sm"><T s={ui.account_noscript} /></p>
    </noscript>

    <div id="account-member" hidden>
      <p
        id="member-demo"
        class="mb-6 rounded bg-gray-100 p-4 dark:bg-slate-800"
        hidden
      >
        <T s={ui.account_demo} />
      </p>
      {
        /* Added 2026-10-02 with the owner's status model (src/config.ts, site.admin; ADMIN.md): the
        member's status, the note a blocked member gets about who closed the materials, and, for a
        metr or an admin, the two panel pages. All three are filled by the script below from the
        user's public metadata; presentation only, the services decide. */
      }
      {
        /* Changed later on 2026-10-02 at the owner's request ("the status should show, so it is
        seen who the member is"): a panel like the demo line above, with the name in bold, instead
        of a small line that was easy to miss. Every signed-in member gets it, a new account too
        ("гость"). */
      }
      {
        /* Changed again the same evening: the status is a section of Clerk's card now
        (src/scripts/account-status.ts), and this panel is only its fallback (the script's note). */
      }
      <p
        id="account-status"
        class="mb-6 rounded bg-gray-100 p-4 text-sm dark:bg-slate-800"
        hidden
      >
      </p>
      <p
        id="account-blocked"
        class="mb-6 rounded bg-gray-100 p-4 text-sm text-red-600 dark:bg-slate-800 dark:text-red-400"
        hidden
      >
      </p>
      <p id="account-admin" class="mb-6 flex gap-4 text-sm" hidden>
        <a
          href={site.admin.postsPage}
          class="text-blue-600 hover:underline dark:text-blue-400"
          ><T s={ui.admin_posts_title} /></a
        >
        <a
          href={site.admin.usersPage}
          class="text-blue-600 hover:underline dark:text-blue-400"
          ><T s={ui.admin_users_title} /></a
        >
      </p>
      <div id="clerk-profile"></div>
      <button
        id="signout-btn"
        type="button"
        class="mt-6 rounded bg-blue-600 px-4 py-2 text-white transition-opacity hover:opacity-90 disabled:opacity-50"
      >
        <T s={ui.account_sign_out} />
      </button>
    </div>

    {
      /* Added 2026-09-28: the markup of the card's "Устройства" page, five devices to a page
      (src/scripts/account-devices.ts clones and fills these; its header says why the page
      exists). The pager copies the classes and chevrons of Pagination.astro, so it looks like
      the site's lists, with buttons in place of links. */
    }
    <template id="devices-template">
      <div>
        <h2 class="mb-4 text-base font-semibold">
          <T s={ui.devices_title} />
        </h2>
        <p data-devices-status class="text-sm"><T s={ui.auth_loading} /></p>
        <ul
          data-devices-list
          class="divide-y divide-gray-200 dark:divide-slate-700"
        >
        </ul>
        <nav
          data-devices-pager
          {...langAttrs({ "aria-label": ui.devices_pages })}
          class="mt-4 flex flex-wrap items-center justify-between gap-y-3"
        >
          <button
            type="button"
            data-devices-prev
            class="flex items-center rounded-md bg-white px-3 py-1 text-sm text-gray-700 shadow-sm transition-colors hover:bg-gray-50 disabled:opacity-40 dark:bg-slate-900 dark:text-gray-300 dark:hover:bg-slate-800"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="mr-1 h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
            </svg>
            <T s={ui.pagination_previous} />
          </button>
          <div data-devices-numbers class="flex flex-wrap justify-center gap-1">
          </div>
          <button
            type="button"
            data-devices-next
            class="flex items-center rounded-md bg-white px-3 py-1 text-sm text-gray-700 shadow-sm transition-colors hover:bg-gray-50 disabled:opacity-40 dark:bg-slate-900 dark:text-gray-300 dark:hover:bg-slate-800"
          >
            <T s={ui.pagination_next} />
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="ml-1 h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </nav>
      </div>
    </template>
    <template id="device-item-template">
      <li class="flex items-start justify-between gap-4 py-3 text-sm">
        <div>
          <p class="font-medium">
            <span data-device-name></span>
            <span
              data-device-current
              class="ml-2 rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-600 dark:bg-slate-700 dark:text-gray-300"
              hidden><T s={ui.devices_this} /></span
            >
          </p>
          <p data-device-browser class="text-gray-500 dark:text-gray-400"></p>
          <p data-device-place class="text-gray-500 dark:text-gray-400"></p>
          <p data-device-time class="text-gray-500 dark:text-gray-400"></p>
        </div>
        <button
          type="button"
          data-device-revoke
          class="shrink-0 text-red-600 hover:underline disabled:opacity-50 dark:text-red-400"
        >
          <T s={ui.devices_revoke} />
        </button>
      </li>
    </template>
    <template id="devices-number-template">
      <button
        type="button"
        class="rounded-md bg-white px-3 py-1 text-sm text-gray-700 shadow-sm transition-colors hover:bg-gray-50 dark:bg-slate-900 dark:text-gray-300 dark:hover:bg-slate-800"
      ></button>
    </template>
    <template id="devices-current-template">
      <span
        aria-current="page"
        class="rounded-md bg-blue-50 px-3 py-1 text-sm text-blue-700 shadow-sm dark:bg-slate-700 dark:text-blue-300"
      ></span>
    </template>
    <template id="devices-gap-template">
      <span
        aria-hidden="true"
        class="px-1 py-1 text-sm text-gray-500 dark:text-gray-400"
        >&hellip;</span
      >
    </template>
    <template id="devices-icon-template">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="12" rx="2" stroke-width="2"></rect>
        <path stroke-linecap="round" stroke-width="2" d="M8 20h8M12 16v4"
        ></path>
      </svg>
    </template>
  </section>
</Base>

<script>
  // Top level of the template, never inside an expression (CLAUDE.md, measured 2026-09-22).
  // reloadOnLanguageChange added 2026-10-12, and the helpers below it (the frontmatter's note).
  import {
    getClerk,
    reloadOnLanguageChange,
    showLoadFailure,
  } from "../../scripts/auth";
  import { ui } from "../../i18n/strings";
  import type { Phrase } from "../../i18n/lang";
  import { phrase, setPhrase } from "../../scripts/lang";
  import { clearAuthFlag } from "../../scripts/auth-flag";
  import { site } from "../../config";
  // Added 2026-09-28: the card's "Устройства" page.
  import { devicesPage } from "../../scripts/account-devices";
  // Added later on 2026-10-02: the status as a section of the card's profile page.
  import { statusInProfile } from "../../scripts/account-status";

  reloadOnLanguageChange();

  const status = document.getElementById("auth-status");
  const member = document.getElementById("account-member");
  const demo = document.getElementById("member-demo");
  const profile = document.getElementById("clerk-profile");
  const signOutButton = document.getElementById("signout-btn");

  try {
    const clerk = await getClerk();
    if (!clerk.isSignedIn) {
      location.replace(
        site.auth.signIn + "?next=" + encodeURIComponent(site.auth.account),
      );
    } else {
      if (demo !== null) {
        demo.hidden = clerk.user?.publicMetadata.member !== true;
      }
      // Added 2026-10-02 (the markup's note): the status, a blocked member's note, the panel links.
      // No status, or a value outside the list, is a guest, as the services count it.
      const metadata = clerk.user?.publicMetadata ?? {};
      const statuses: readonly string[] = site.admin.statuses;
      // Changed 2026-10-12: Phrase, each name in both languages (was Record<string, string>).
      const names: Record<string, Phrase> = site.admin.statusNames;
      const current =
        typeof metadata.status === "string" &&
        statuses.includes(metadata.status)
          ? metadata.status
          : "guest";
      const statusLine = document.getElementById("account-status");
      if (statusLine !== null) {
        // Changed later on 2026-10-02 (the markup's note): "Ваш статус:" and the name in bold.
        const name = document.createElement("strong");
        // Changed 2026-10-12: in the language shown (the frontmatter's note); it was the Russian
        // name and "Ваш статус: ".
        name.textContent = phrase(names[current] ?? current);
        statusLine.replaceChildren(phrase(ui.account_your_status) + " ", name);
        // Changed again later on 2026-10-02 at the owner's request: the status is shown inside
        // Clerk's card (account-status.ts, below the mount), and this panel only when that has not
        // happened 5 seconds after the card was mounted - a Clerk update that renamed its class
        // hooks, or a first load on another tab of the card. It hides again once the section is in.
      }
      const blocked = document.getElementById("account-blocked");
      if (blocked !== null && current === "blocked") {
        // Changed 2026-10-12: both languages; it was the Russian sentence "Доступ к материалам сайта
        // закрыт" with "администратором" or "метром".
        setPhrase(
          blocked,
          metadata.statusBy === "admin"
            ? ui.account_blocked_by_admin
            : ui.account_blocked_by_metr,
        );
        blocked.hidden = false;
      }
      const adminLinks = document.getElementById("account-admin");
      if (adminLinks !== null) {
        adminLinks.hidden = current !== "admin" && current !== "metr";
      }
      if (profile instanceof HTMLDivElement) {
        // Changed 2026-09-28 at the colleague's request ("the account is far too tall, halve it at
        // least"): Clerk gives the profile card a fixed height of 44rem (its size token $176 in
        // @clerk/ui 1.36.0), which left most of the card empty on this site, where the profile
        // shows an email address and a password. "auto" lets the card be as tall as the section
        // on show. It goes on this mount only, not on the shared appearance in auth.ts: the
        // sign-in and sign-up cards have no fixed height to undo. UserProfileProps.appearance is
        // merged over the global one (the type's own note in @clerk/shared).
        // Changed again 2026-09-28 at the owner's request (five devices to a page): Clerk's own
        // device list under Безопасность is hidden, and a card page of our own, "Устройства",
        // shows the same sessions with a pager (src/scripts/account-devices.ts says how). The two
        // default pages are listed so that they keep their places before it (Clerk, "Reorder
        // default routes").
        clerk.mountUserProfile(profile, {
          routing: "hash",
          appearance: {
            elements: {
              cardBox: { height: "auto" },
              profileSection__activeDevices: { display: "none" },
            },
          },
          customPages: [
            { label: "account" },
            { label: "security" },
            devicesPage(clerk),
          ],
        });
        // Added later on 2026-10-02 (the status line's note above): the status inside the card.
        let inCard = false;
        // Changed 2026-10-12: the name in the language shown (phrase).
        statusInProfile(profile, phrase(names[current] ?? current), () => {
          inCard = true;
          if (statusLine !== null) statusLine.hidden = true;
        });
        setTimeout(() => {
          if (!inCard && statusLine !== null) {
            console.warn(
              "Account: the status section was not placed in Clerk's card; shown above it (src/scripts/account-status.ts).",
            );
            statusLine.hidden = false;
          }
        }, 5000);
      }
      if (signOutButton instanceof HTMLButtonElement) {
        signOutButton.addEventListener("click", async () => {
          signOutButton.disabled = true;
          // Changed 2026-10-12: both languages (it was "Выходим...").
          setPhrase(signOutButton, ui.account_signing_out);
          // Clerk clears the session; the listener in auth.ts clears the header's flag, and
          // afterSignOutUrl (set in auth.ts) sends the visitor to the home page.
          // Added 2026-09-26: the flag is cleared here, before Clerk is asked, because the first
          // real run showed Clerk navigating home before it reported the ended session, so the
          // listener never cleared it and the home page still showed a member's header. Clearing
          // first is the safe side: a failed sign-out shows a guest's header until the next
          // auth page corrects it, never the other way round (auth-flag.ts, fail-closed).
          clearAuthFlag();
          await clerk.signOut();
        });
      }
      status?.remove();
      if (member !== null) member.hidden = false;
    }
  } catch (error) {
    showLoadFailure(status, error);
  }
</script>
