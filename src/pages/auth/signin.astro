---
// /auth/signin/ - sign-in, through Clerk's sign-in component.
//
// Rewritten on 2026-09-26 for the move to Clerk (CLERK.md step 5). signup.astro next to this file
// carries the reasoning the three auth pages share (static page, routing "hash", Russian strings,
// settings in the Clerk Dashboard); the part that is this page's own follows.
//
// Password recovery is part of Clerk's component ("Forgot password?" inside the form, by a code
// sent to the mail), so the two recovery pages of 2026-09-25 are gone and nothing links to them.
//
// `next`: the address to return to after the sign-in, a path on this site only. nextPath() in
// src/scripts/auth.ts is the one home of that rule, so the parameter cannot turn this page into an
// open redirect; without it the destination is the account page. A visitor who is already signed
// in is sent there straight away, by the script: at build time there is no visitor to look at.
import Base from "../../layouts/Base.astro";
// Added 2026-09-26: Clerk's components in the site's colours and font (src/styles/clerk.css says
// how). Imported here, as carousel.css and search.css are by the pages that need them.
import "../../styles/clerk.css";
---

<Base title="Вход">
  <section class="mx-auto max-w-md">
    <!-- <h1 class="mb-6 text-2xl font-bold">Вход</h1> -->
    <div id="clerk-signin"></div>
    <p id="auth-status" class="mt-4 text-sm" role="status" aria-live="polite">
      Загрузка...
    </p>
    <noscript>
      <p class="text-sm">Для входа нужен включённый JavaScript.</p>
    </noscript>
  </section>
</Base>

<script>
  // Top level of the template, never inside an expression (CLAUDE.md, measured 2026-09-22).
  import { getClerk, nextPath, showLoadFailure } from "../../scripts/auth";
  import { site } from "../../config";

  const root = document.getElementById("clerk-signin");
  const status = document.getElementById("auth-status");
  const next = nextPath(new URLSearchParams(location.search).get("next"));

  try {
    const clerk = await getClerk();
    if (clerk.isSignedIn) {
      // replace, not assignment, so the sign-in page does not stay in the history behind `next`.
      location.replace(next);
    } else if (root instanceof HTMLDivElement) {
      // Changed 2026-09-28, reported by the owner: signed in from a paid video's button, they
      // came back to the video still shown as a guest. Clerk's setActive() (clerk-js 6.34.1)
      // navigates to the redirect first and sets the new session only after that navigation, a
      // step that never runs because the page unloads; so the router hooks in auth.ts still see
      // the old, empty session and write no header flag. The account page never showed it,
      // because it loads Clerk and writes the flag itself; the video page loads Clerk only when
      // the flag is there. The redirect now comes back to this page with the same `next`: this
      // page loads Clerk, finds the session, the listener writes the flag, and the branch above
      // replaces the address with `next`. One extra load of a cached page, and no reliance on
      // Clerk's internal order.
      clerk.mountSignIn(root, {
        routing: "hash",
        signUpUrl: site.auth.signUp,
        forceRedirectUrl:
          site.auth.signIn + "?next=" + encodeURIComponent(next),
      });
      status?.remove();
    }
  } catch (error) {
    showLoadFailure(status, error);
  }

  document.addEventListener("click", (event) => {
    // Ищем клик по кнопке
    const target = event.target as HTMLElement;
    const btnSupport = target.closest(
      '[data-localization-key="signIn.alternativeMethods.getHelp.blockButton__emailSupport"]',
    );

    if (btnSupport) {
      // Отменяем стандартное поведение Clerk
      event.preventDefault();
      event.stopPropagation();

      // Находим и открываем форму из футера
      const feedbackForm = document.getElementById("contact-modal");
      if (feedbackForm) {
        // открытие формы
        feedbackForm.classList.remove("hidden");
      }
    }
  });
</script>
